---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BaseLayout from "@/layouts/Base";
import { getAllWritings } from "@/utils";

export const getStaticPaths = (async () => {
	const writingEntries = await getAllWritings();
	return writingEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, publishDate, updatedDate } = entry.data;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
---

<BaseLayout meta={{ title, description, articleDate }}>
	<article class="flex-grow break-words">
		<header class="mb-8">
			<h1 class="title text-2xl">{title}</h1>
			<time class="text-sm text-gray-500" datetime={articleDate}>
				{publishDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}
			</time>
		</header>
		<div class="prose prose-sm prose-cactus prose-headings:font-semibold prose-headings:text-accent-2">
			<Content />
		</div>
	</article>
</BaseLayout>
